

APP_NAME=CloudPulse
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=


APP_VERSION=dev
APP_COMMIT_SHA=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12


TRUSTED_PROXIES=*


LOG_CHANNEL=stderr
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=127.0.0.1

DB_READ_HOST=
DB_PORT=3306
DB_DATABASE=cloudpulse
DB_USERNAME=cloudpulse

DB_PASSWORD=
DB_TIMEOUT=3


REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis


FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cloudpulse-uploads
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

CLOUDPULSE_DISK=s3
CLOUDPULSE_MAX_UPLOAD_KB=10240
CLOUDPULSE_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,txt,csv,zip
CLOUDPULSE_UPLOADS_PER_MINUTE=20
CLOUDPULSE_STATUS_POLL_SECONDS=10

VITE_APP_NAME="${APP_NAME}"
